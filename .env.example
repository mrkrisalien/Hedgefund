# Non-secret runtime defaults only. API keys are entered on /settings
# and stored in the browser until the Dhan token expires.

DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DELTA_BASE_URL=https://api.india.delta.exchange

DEFAULT_RISK_PERCENT=1.0
SCAN_INTERVAL_SECONDS=30
CONFIDENCE_THRESHOLD=65
SYMBOLS=RELIANCE,TCS,HDFCBANK,INFY,ICICIBANK
AUDIT_TRADE_THRESHOLD=10
AUDIT_COOLDOWN_HOURS=12
MAX_DAY_LOSS_RS=3000
MAX_DAY_PROFIT_RS=5000
