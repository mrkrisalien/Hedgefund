# Copy to .env and fill values. Never commit real secrets.

# LLM
DEEPSEEK_API_KEY=your_deepseek_api_key_here
GROQ_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Dhan HQ (India). MT5 is not used — it is blocked for retail India.
DHAN_CLIENT_ID=your_dhan_client_id
DHAN_ACCESS_TOKEN=your_dhan_access_token

# Optional Delta Exchange India desk (BTC options paper by default)
DELTA_API_KEY=
DELTA_API_SECRET=
DELTA_BASE_URL=https://api.india.delta.exchange

DEFAULT_RISK_PERCENT=1.0
SCAN_INTERVAL_SECONDS=30
CONFIDENCE_THRESHOLD=65
SYMBOLS=RELIANCE,TCS,HDFCBANK,INFY,ICICIBANK
AUDIT_TRADE_THRESHOLD=10
AUDIT_COOLDOWN_HOURS=12
MAX_DAY_LOSS_RS=3000
MAX_DAY_PROFIT_RS=5000
